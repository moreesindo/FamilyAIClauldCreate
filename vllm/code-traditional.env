# vLLM Configuration for Code Traditional (Qwen2.5-Coder-32B)
# Additional environment variables specific to this model

# Quantization settings (AWQ INT4 for memory efficiency)
VLLM_QUANTIZATION=awq
VLLM_KV_CACHE_DTYPE=auto

# Model-specific overrides optimized for multi-model deployment
VLLM_GPU_MEMORY_UTILIZATION=0.30
VLLM_MAX_NUM_SEQS=128
VLLM_MAX_NUM_BATCHED_TOKENS=8192

# Performance tuning
VLLM_SWAP_SPACE=2
VLLM_ENABLE_PREFIX_CACHING=true
VLLM_ENFORCE_EAGER=true
