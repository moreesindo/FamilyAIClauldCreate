# vLLM Configuration for Vision (Qwen3-VL-8B)
# Additional environment variables specific to this model

# Quantization settings (FP8 for memory efficiency)
VLLM_QUANTIZATION=fp8
VLLM_KV_CACHE_DTYPE=fp8

# Model-specific overrides optimized for multi-model deployment
VLLM_GPU_MEMORY_UTILIZATION=0.35
VLLM_MAX_NUM_SEQS=64
VLLM_MAX_NUM_BATCHED_TOKENS=8192

# Vision model settings (adjust if needed for Qwen3-VL)
VLLM_IMAGE_INPUT_TYPE=pixel_values
VLLM_IMAGE_TOKEN_ID=151655
VLLM_IMAGE_FEATURE_SIZE=256

# Performance tuning
VLLM_SWAP_SPACE=1
VLLM_ENABLE_PREFIX_CACHING=false
VLLM_ENFORCE_EAGER=true
