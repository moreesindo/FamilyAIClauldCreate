# vLLM Configuration for Code Agentic (Qwen3-Coder-30B-A3B)
# Additional environment variables specific to this model

# Quantization settings (GPTQ for INT4 quantized MoE models)
# Note: Using standard gptq instead of gptq_marlin due to CUDA kernel compatibility
# gptq_marlin's MacheteLinearKernel may not be available on all GPU architectures
VLLM_QUANTIZATION=gptq
VLLM_KV_CACHE_DTYPE=auto

# Model-specific overrides optimized for multi-model deployment
VLLM_GPU_MEMORY_UTILIZATION=0.30
VLLM_MAX_NUM_SEQS=128
VLLM_MAX_NUM_BATCHED_TOKENS=16384

# Long context support (MoE benefits from longer context)
VLLM_ENABLE_CHUNKED_PREFILL=true

# Performance tuning
VLLM_SWAP_SPACE=2
VLLM_ENABLE_PREFIX_CACHING=true
VLLM_ENFORCE_EAGER=true
