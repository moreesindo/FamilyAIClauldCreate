# vLLM Configuration for Chat Light (Qwen3-4B)
# Additional environment variables specific to this model

# Quantization settings (FP8 for memory efficiency)
VLLM_QUANTIZATION=fp8
VLLM_KV_CACHE_DTYPE=fp8

# Model-specific overrides optimized for maximum throughput
VLLM_GPU_MEMORY_UTILIZATION=0.40
VLLM_MAX_NUM_SEQS=512
VLLM_MAX_NUM_BATCHED_TOKENS=16384

# Performance tuning for maximum throughput
VLLM_SWAP_SPACE=1
VLLM_ENABLE_PREFIX_CACHING=true
VLLM_ENFORCE_EAGER=true
