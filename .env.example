# FamilyAI Environment Configuration Template (Simplified Edition)
# Copy this file to .env and customize for your deployment
#
# Architecture: llama.cpp-based with 4 core services
# - Code Assistant (Qwen3-30B-A3B GGUF)
# - Vision (LLaVA-1.5-7B GGUF)
# - Speech Recognition (Whisper)
# - Speech Synthesis (Piper)

# =============================================================================
# Jetson Thor Configuration
# =============================================================================
JETSON_THOR_IP=192.168.1.100
JETSON_THOR_HOSTNAME=familyai-thor

# =============================================================================
# Proxy Configuration
# =============================================================================
# HTTP/HTTPS proxy for model downloads and container networking
# IMPORTANT: Use host machine IP, NOT 127.0.0.1 (which points to container itself)
#
# Method 1: Use host machine IP (Recommended for Jetson Thor)
PROXY_URL=http://192.168.3.84:2526
#
# Method 2: Use Docker bridge gateway (if proxy runs on host)
# PROXY_URL=http://172.28.0.1:2526
#
# Method 3: If proxy runs inside Docker network
# PROXY_URL=http://proxy-container:2526

# No proxy exceptions (don't proxy these addresses)
NO_PROXY=localhost,127.0.0.1,172.28.0.0/16,192.168.3.84

# =============================================================================
# HuggingFace Configuration
# =============================================================================
# HuggingFace token for model downloads (optional, only needed for gated models)
# HF_TOKEN=your_huggingface_token_here

# Model cache directory
# IMPORTANT: This path is for Jetson Thor server
HF_HOME=/home/sindoyang/.cache/huggingface
TRANSFORMERS_CACHE=/home/sindoyang/.cache/huggingface/hub

# Model Download:
# Use GGUF download script: ./scripts/download-gguf-models.sh
# This automatically downloads pre-quantized GGUF models

# =============================================================================
# llama.cpp Global Configuration
# =============================================================================
# GGUF model directory (where Q4_K_M quantized models are stored)
GGUF_OUTPUT_DIR=/home/sindoyang/.cache/familyai/gguf

# GPU layers to offload (999 = all layers, 0 = CPU only)
# For Jetson Thor with 128GB RAM, use 999 to offload all layers to GPU
LLAMACPP_GPU_LAYERS=999

# Number of parallel requests to handle
# Higher values allow more concurrent users but use more memory
LLAMACPP_N_PARALLEL=8

# =============================================================================
# Service 1: Code Assistant (Qwen3-30B-A3B MoE)
# =============================================================================
# Model: unsloth/Qwen3-30B-A3B-Instruct-2507-GGUF (Q4_K_M)
# Memory: ~18.6GB
# Use Case: Code generation, understanding, refactoring, debugging
CODE_AGENTIC_GGUF=Qwen3-30B-A3B-Instruct-2507-Q4_K_M.gguf
CODE_AGENTIC_PORT=8001
CODE_AGENTIC_MAX_MODEL_LEN=32768

# =============================================================================
# Service 2: Vision Understanding (LLaVA 1.5-7B)
# =============================================================================
# Model: mys/ggml_llava-v1.5-7b (Q4_K_M)
# Memory: ~4.9GB (language model + mmproj)
# Use Case: Image understanding, visual Q&A, object recognition
VISION_GGUF=ggml-model-q4_k.gguf
VISION_MMPROJ=mmproj-model-f16.gguf
VISION_PORT=8002
VISION_MAX_MODEL_LEN=16384

# =============================================================================
# Service 3: Speech Recognition (Whisper ASR)
# =============================================================================
# Model: Systran/faster-whisper-small (CTranslate2 format)
# Memory: ~2GB
# Use Case: Audio/video transcription to text
WHISPER_MODEL=Systran/faster-whisper-small
WHISPER_PORT=8003
WHISPER_LANGUAGE=auto  # or specify: en, zh, etc.

# =============================================================================
# Service 4: Speech Synthesis (Piper TTS)
# =============================================================================
# Model: en_US-lessac-medium
# Memory: ~0.5GB
# Use Case: Text-to-speech for podcast/voice generation
PIPER_MODEL=en_US-lessac-medium
PIPER_PORT=8004
PIPER_VOICE=lessac  # Voice name

# =============================================================================
# Optional: Intelligent Routing Gateway (Simplified)
# =============================================================================
GATEWAY_PORT=8080
GATEWAY_LOG_LEVEL=INFO

# =============================================================================
# Optional: Open WebUI Configuration
# =============================================================================
WEBUI_PORT=3000
WEBUI_SECRET_KEY=change_this_to_a_random_secret_key
WEBUI_DATA_DIR=./data/open-webui

# Authentication
WEBUI_ENABLE_SIGNUP=true
WEBUI_DEFAULT_USER_ROLE=user

# Integration with gateway
WEBUI_OLLAMA_BASE_URL=http://gateway:8080/v1

# =============================================================================
# Optional: Monitoring Configuration
# =============================================================================
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_ADMIN_PASSWORD=change_this_password

# =============================================================================
# Optional: Security Configuration
# =============================================================================
# API authentication (disabled for home use)
API_AUTH_ENABLED=false
API_KEY=change_this_to_a_secure_api_key

# Rate limiting (disabled for home use)
RATE_LIMIT_ENABLED=false
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# =============================================================================
# Logging Configuration
# =============================================================================
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL

# =============================================================================
# Resource Summary (Jetson Thor 128GB)
# =============================================================================
# Service             Memory      Port    Status
# --------------------------------------------------
# code-agentic        ~18.6GB     8001    Core
# vision (LLaVA)      ~4.9GB      8002    Core
# whisper (ASR)       ~2GB        8003    Core
# piper (TTS)         ~0.5GB      8004    Core
# --------------------------------------------------
# Total               ~26GB       -       Always Running
# Remaining           ~102GB      -       Available for concurrency
# =============================================================================
